+fn path_is_allowed(path: &Path, prefix: &Path) -> bool {
+	let Ok(canonical_path) = path.canonicalize() else {
+		return false;
+	};
+
+	if canonical_path.starts_with(prefix) {
+		return true;
+	}
+
+	let plugins_dir = prefix.join("plugins");
+
+	let Ok(relative_path) = path.strip_prefix(&plugins_dir) else {
+		return false;
+	};
+
+	let Some(plugin_name) = relative_path.components().next() else {
+		return false;
+	};
+
+	let plugin_path = plugins_dir.join(plugin_name.as_os_str());
+
+	plugin_path
+		.symlink_metadata()
+		.is_ok_and(|metadata| metadata.file_type().is_symlink())
+		&& plugin_path
+			.canonicalize()
+			.is_ok_and(|plugin_root| plugin_root.is_dir() && canonical_path.starts_with(plugin_root))
+}
