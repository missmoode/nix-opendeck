 use tauri::{AppHandle, Emitter, Manager, command};
 use tokio::fs;

+fn is_home_manager_plugin(id: &str) -> bool {
+	let state_file = std::env::var_os("XDG_STATE_HOME")
+		.map(std::path::PathBuf::from)
+		.or_else(|| {
+			std::env::var_os("HOME")
+				.map(|home| std::path::PathBuf::from(home).join(".local/state"))
+		})
+		.map(|state_dir| state_dir.join("opendeck/home-manager-plugins"));
+
+	state_file.is_some_and(|path| {
+		std::fs::read_to_string(path)
+			.map(|state| state.lines().any(|plugin_id| plugin_id == id))
+			.unwrap_or(false)
+	})
+}
