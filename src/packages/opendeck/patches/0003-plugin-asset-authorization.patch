+	use super::*;
+	use std::sync::atomic::{AtomicU64, Ordering};
+
+	static NEXT_FIXTURE: AtomicU64 = AtomicU64::new(0);
+
+	struct Fixture(PathBuf);
+
+	impl Fixture {
+		fn new() -> Self {
+			let path = std::env::temp_dir().join(format!(
+				"opendeck-assets-test-{}-{}",
+				std::process::id(), NEXT_FIXTURE.fetch_add(1, Ordering::Relaxed)
+			));
+			std::fs::create_dir(&path).unwrap();
+			Self(path)
+		}
+
+		fn file(&self, relative: &str) -> PathBuf {
+			let path = self.0.join(relative);
+			std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+			std::fs::write(&path, b"asset").unwrap();
+			path
+		}
+	}
+
+	impl Drop for Fixture {
+		fn drop(&mut self) { let _ = std::fs::remove_dir_all(&self.0); }
+	}
+
+	#[test]
+	fn accepts_config_files_and_only_the_authorized_package() {
+		let fixture = Fixture::new();
+		let config = fixture.file("config/settings.json");
+		let allowed = fixture.file("store/allowed.sdPlugin/icons/action.svg");
+		let unrelated = fixture.file("store/other.sdPlugin/icons/action.svg");
+		let prefix = fixture.0.join("config").canonicalize().unwrap();
+		let package = fixture.0.join("store/allowed.sdPlugin");
+
+		assert!(path_is_allowed_with_packages(&config, &prefix, None));
+		assert!(path_is_allowed_with_packages(&allowed, &prefix, Some(&package)));
+		assert!(!path_is_allowed_with_packages(&unrelated, &prefix, Some(&package)));
+		assert!(!path_is_allowed_with_packages(&unrelated, &prefix, None));
+	}
+
+	#[test]
+	fn allows_managed_symlink_assets_without_exposing_the_store() {
+		use std::os::unix::fs::symlink;
+
+		let fixture = Fixture::new();
+		let allowed = fixture.file("store/managed/icons/action.svg");
+		let unrelated = fixture.file("store/unrelated/icons/action.svg");
+		let config = fixture.0.join("config");
+		std::fs::create_dir_all(config.join("plugins")).unwrap();
+		let link = config.join("plugins/managed.sdPlugin");
+		symlink(allowed.parent().unwrap().parent().unwrap(), &link).unwrap();
+		let prefix = config.canonicalize().unwrap();
+
+		assert!(path_is_allowed_with_packages(&link.join("icons/action.svg"), &prefix, None));
+		assert!(!path_is_allowed_with_packages(&unrelated, &prefix, None));
+	}
+
+	#[test]
+	fn rejects_escaping_symlinks_and_parent_components() {
+		use std::os::unix::fs::symlink;
+
+		let fixture = Fixture::new();
+		let outside = fixture.file("outside/secret.txt");
+		let config = fixture.0.join("config");
+		std::fs::create_dir_all(config.join("plugins")).unwrap();
+		symlink(&outside, config.join("escape.txt")).unwrap();
+		let prefix = config.canonicalize().unwrap();
+		assert!(!path_is_allowed_with_packages(&config.join("escape.txt"), &prefix, None));
+		assert!(!path_is_allowed_with_packages(&config.join("plugins/../escape.txt"), &prefix, None));
+	}
+}
