+// Keep the lexical plugin entry: canonicalising it first would lose the ID and
+// allow unrelated paths into the same store tree to acquire its authorization.
+fn path_is_allowed_with_packages(path: &Path, prefix: &Path, package_root: Option<&Path>) -> bool {
+	if path.components().any(|component| matches!(component, std::path::Component::ParentDir | std::path::Component::CurDir))
+		|| path.to_str().is_some_and(|path| path.split('/').any(|component| component == "." || component == ".."))
+	{
+		return false;
+	}
+
+	let Ok(canonical_path) = path.canonicalize() else {
+		return false;
+	};
+
+	if canonical_path.starts_with(prefix) {
+		return true;
+	}
+
+	let plugins_dir = prefix.join("plugins");
+	if let Ok(relative_path) = path.strip_prefix(&plugins_dir)
+		&& let Some(std::path::Component::Normal(plugin_name)) = relative_path.components().next()
+	{
+		let plugin_path = plugins_dir.join(plugin_name);
+		if plugin_path.symlink_metadata().is_ok_and(|metadata| metadata.file_type().is_symlink())
+			&& plugin_path.canonicalize().is_ok_and(|plugin_root| plugin_root.is_dir() && canonical_path.starts_with(plugin_root))
+		{
+			return true;
+		}
+	}
+
+	package_root.is_some_and(|plugin_path| {
+		path.starts_with(plugin_path)
+			&& plugin_path.canonicalize().is_ok_and(|plugin_root| plugin_root.is_dir() && canonical_path.starts_with(plugin_root))
+	})
+}
+
+fn path_is_allowed(path: &Path, prefix: &Path) -> bool {
+	let package_root = super::sources::effective_package_asset_root(path);
+	path_is_allowed_with_packages(path, prefix, package_root.as_deref())
+}
+
+#[derive(Debug, PartialEq)]
+enum InspectorMode { None, Parent, Child }
+
+// Strip one protocol suffix, then use this same target for authorization and IO.
+fn request_target(url: &str) -> (&Path, InspectorMode) {
+	if let Some(path) = url.strip_suffix("|opendeck_property_inspector_child") {
+		(Path::new(path), InspectorMode::Child)
+	} else if let Some(path) = url.strip_suffix("|opendeck_property_inspector") {
+		(Path::new(path), InspectorMode::Parent)
+	} else {
+		(Path::new(url), InspectorMode::None)
+	}
+}
