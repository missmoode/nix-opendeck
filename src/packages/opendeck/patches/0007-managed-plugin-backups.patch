+fn linked_plugins(plugins_dir: &Path) -> std::io::Result<Vec<PathBuf>> {
+	let entries = match read_dir(plugins_dir) {
+		Ok(entries) => entries,
+		Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(vec![]),
+		Err(error) => return Err(error),
+	};
+	let mut links = vec![];
+	for entry in entries {
+		let entry = entry?;
+		if entry.file_type()?.is_symlink() {
+			links.push(entry.path());
+		}
+	}
+	Ok(links)
+}
+
+#[cfg(all(test, unix))]
+mod managed_plugin_backup_tests {
+	use super::{add_dir_to_zip, linked_plugins};
+	use std::fs::{self, File};
+	use std::os::unix::fs::symlink;
+	use std::path::{Path, PathBuf};
+	use zip::{ZipArchive, ZipWriter, write::FileOptions};
+
+	struct TestDir(PathBuf);
+
+	impl TestDir {
+		fn new() -> Self {
+			let path = std::env::temp_dir().join(format!(
+				"opendeck-plugin-backup-{}-{}",
+				std::process::id(),
+				std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+			));
+			fs::create_dir(&path).unwrap();
+			Self(path)
+		}
+	}
+
+	impl Drop for TestDir {
+		fn drop(&mut self) {
+			let _ = fs::remove_dir_all(&self.0);
+		}
+	}
+
+	fn plugin_dir(root: &Path, id: &str) -> PathBuf {
+		root.join("plugins").join(id)
+	}
+
+	#[test]
+	fn backup_excludes_links_and_ownership_but_keeps_user_plugins() {
+		let temp = TestDir::new();
+		let config = temp.0.join("config");
+		let external = temp.0.join("external");
+		fs::create_dir_all(&external).unwrap();
+		fs::write(external.join("not-for-backup"), "store content").unwrap();
+		fs::create_dir_all(plugin_dir(&config, "user.sdPlugin")).unwrap();
+		fs::write(plugin_dir(&config, "user.sdPlugin").join("settings.json"), "user data").unwrap();
+		fs::write(config.join("externally-managed-plugins"), "managed.sdPlugin\n").unwrap();
+		symlink(&external, plugin_dir(&config, "managed.sdPlugin")).unwrap();
+
+		let archive_path = temp.0.join("backup.zip");
+		let mut zip = ZipWriter::new(File::create(&archive_path).unwrap());
+		let options = FileOptions::default();
+		let mut skipped = linked_plugins(&config.join("plugins")).unwrap();
+		skipped.push(config.join("externally-managed-plugins"));
+		add_dir_to_zip(&mut zip, &config, &config, options, &skipped).unwrap();
+		zip.finish().unwrap();
+
+		let mut archive = ZipArchive::new(File::open(archive_path).unwrap()).unwrap();
+		assert!(archive.by_name("plugins/user.sdPlugin/settings.json").is_ok());
+		assert!(archive.by_name("plugins/managed.sdPlugin/").is_err());
+		assert!(archive.by_name("plugins/managed.sdPlugin/not-for-backup").is_err());
+		assert!(archive.by_name("externally-managed-plugins").is_err());
+	}
+}
