+//! Rebind cached resource paths when a plugin's effective source changes.
+
+use crate::shared::{ActionInstance, ActionState, Profile, initialise_encoder_layout};
+use std::path::{Component, Path, PathBuf};
+
+/// Rebase only resources lexically beneath a known source for this plugin.
+/// Canonicalising would lose a symlink entry that may already have changed.
+pub fn rebind_resource_path(value: &mut String, roots: &[PathBuf], destination: &Path) {
+	if value.is_empty() || value.starts_with("data:") || value.starts_with("opendeck/") || value.starts_with('$') {
+		return;
+	}
+	for root in roots {
+		if let Ok(relative) = Path::new(value.as_str()).strip_prefix(root)
+			&& !relative.components().any(|component| matches!(component, Component::ParentDir))
+		{
+			*value = destination.join(relative).to_string_lossy().into_owned();
+			return;
+		}
+	}
+}
+
+fn rebind_state(state: &mut ActionState, roots: &[PathBuf], destination: &Path) {
+	rebind_resource_path(&mut state.image, roots, destination);
+	if let Some(image) = &mut state.image_override {
+		rebind_resource_path(image, roots, destination);
+	}
+}
+
+fn rebind_instance(instance: &mut ActionInstance, id: &str, roots: &[PathBuf], destination: &Path) -> bool {
+	let mut affected = instance.action.plugin == id;
+	if affected {
+		rebind_resource_path(&mut instance.action.icon, roots, destination);
+		rebind_resource_path(&mut instance.action.property_inspector, roots, destination);
+		for state in instance.action.states.iter_mut().chain(&mut instance.states) {
+			rebind_state(state, roots, destination);
+		}
+		if let Some(encoder) = &mut instance.action.encoder {
+			rebind_resource_path(&mut encoder.icon, roots, destination);
+			rebind_resource_path(&mut encoder.background, roots, destination);
+			rebind_resource_path(&mut encoder.layout, roots, destination);
+			// Even an unchanged lexical HM path may now resolve to different files.
+			encoder.layout_parsed = None;
+		}
+		if let Err(error) = initialise_encoder_layout(&mut instance.action, None) {
+			log::warn!("Failed to reload encoder layout for {id} action {}: {error:#}", instance.action.uuid);
+		}
+	}
+	if let Some(children) = &mut instance.children {
+		for child in children {
+			affected |= rebind_instance(child, id, roots, destination);
+		}
+	}
+	affected
+}
+
+pub fn rebind_profile_resources(profile: &mut Profile, id: &str, roots: &[PathBuf], destination: &Path) {
+	let mut affected = false;
+	for instance in profile.keys.iter_mut().chain(&mut profile.sliders).chain(&mut profile.infobars).flatten() {
+		affected |= rebind_instance(instance, id, roots, destination);
+	}
+	profile.stale |= affected;
+}
