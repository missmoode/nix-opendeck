+/// Verify that installation can only write beneath the ID whose ownership was checked.
+/// Keep the nested-archive handling used by `dir_name` and `extract`.
+pub fn validate_plugin_archive<S: Read + Seek>(source: S, id: &str) -> Result<(), ZipExtractError> {
+	let mut archive = zip::ZipArchive::new(source)?;
+	if archive.len() == 1 {
+		let file = archive.by_index(0)?;
+		if file.is_file() {
+			return validate_plugin_archive(Cursor::new(BufReader::new(file).bytes().flatten().collect::<Vec<u8>>()), id);
+		}
+	}
+
+	for index in 0..archive.len() {
+		let file = archive.by_index(index)?;
+		let name = file.name().replace('\\', "/");
+		let path = Path::new(&name);
+		let mut components = path.components().filter(|component| !matches!(component, std::path::Component::CurDir));
+		let root_matches = matches!(components.next(), Some(std::path::Component::Normal(root)) if root == id);
+		if !root_matches || components.any(|component| !matches!(component, std::path::Component::Normal(_))) {
+			return Err(io::Error::new(io::ErrorKind::InvalidData, "Plugin archive contains paths outside the selected plugin directory").into());
+		}
+	}
+	Ok(())
+}
