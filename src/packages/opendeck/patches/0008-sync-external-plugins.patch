+/// Notify the running instance that an external package manager changed one plugin.
+/// Does not install files or erase saved plugin settings/profile assignments.
+pub async fn sync_external_plugin(app: AppHandle, id: String) {
+	// An explicit plugin ID, never a path supplied by the caller.
+	let valid = id.strip_suffix(".sdPlugin").is_some_and(|stem| !stem.is_empty())
+		&& id.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'.' | b'_' | b'-'));
+	if !valid {
+		log::warn!("Refusing to sync invalid plugin ID: {id:?}");
+		return;
+	}
+
+	let path = config_dir().join("plugins").join(&id);
+	let installed = path.is_dir();
+	let mut loaded = false;
+	let _ = deactivate_plugin(&app, &id).await;
+
+	// Unloading or replacing a plugin must discard its in-memory actions.
+	// Keep actions belonging to other plugins in the same category.
+	{
+		let mut categories = crate::shared::CATEGORIES.write().await;
+		for category in categories.values_mut() {
+			category.actions.retain(|action| action.plugin != id);
+		}
+		categories.retain(|_, category| !category.actions.is_empty());
+	}
+
+	if installed {
+		let tx = (*app.state::<mpsc::Sender<SpawnRequest>>()).clone();
+		match initialise_plugin(path, tx).await {
+			Ok(()) => {
+				loaded = true;
+				let locks = acquire_locks().await;
+				for context in locks.profile_stores.all_from_plugin(&id) {
+					if let Ok(Some(instance)) = get_instance(&context, &locks).await {
+						let _ = crate::events::outbound::will_appear::will_appear(instance).await;
+					}
+				}
+			}
+			Err(error) => log::warn!("Failed to sync external plugin {id}: {error:#}"),
+		}
+	}
+
+	if let Some(window) = app.get_webview_window("main") {
+		if loaded {
+			let _ = window.emit("plugin_reloaded", &id);
+		}
+		let _ = window.emit("plugins_changed", &id);
+	}
+}
