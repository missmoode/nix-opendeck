+
+fn get_icon_path(path: &str) -> Option<PathBuf> {
+    let icon = find_app(path)?.icon?;
+    let fetcher = IconFetcher::new();
+
+	// Desktop entries may specify an absolute path directly
+    if Path::new(&icon).is_absolute() {
+    	let path = PathBuf::from(&icon);
+
+    	if path.is_file() {
+    		return Some(path)
+    	}
+    }
+
+    // Try the configured icon theme.
+    if let Some(path) = fetcher.get_icon_path(icon.clone()) {
+        return Some(path);
+    }
+
+    // Some desktop entries use different capitalization from the actual
+    // icon filename.
+    if let Some(path) = fetcher.get_icon_path(icon.to_lowercase()) {
+        return Some(path);
+    }
+
+    // Search all XDG hicolor roots. This matters on systems such as NixOS,
+    // where multiple independent profiles can contribute to the same theme.
+    if let Some(path) = find_xdg_icon(&icon, HICOLOR_APP_DIRS) {
+        return Some(path);
+    }
+
+    if let Some(path) = find_xdg_icon(&icon.to_lowercase(), HICOLOR_APP_DIRS) {
+        return Some(path);
+    }
+
+    // pixmaps is an older but still commonly used location for application
+    // icons.
+    if let Some(path) = find_xdg_icon(&icon, PIXMAP_DIRS) {
+        return Some(path);
+    }
+
+    find_xdg_icon(&icon.to_lowercase(), PIXMAP_DIRS)
+}
+
+fn xdg_data_dirs() -> Vec<PathBuf> {
+    let mut dirs = Vec::new();
+
+    if let Some(data_home) = std::env::var_os("XDG_DATA_HOME") {
+        if !data_home.is_empty() {
+            dirs.push(PathBuf::from(data_home));
+        }
+    } else if let Some(home) = std::env::var_os("HOME") {
+        dirs.push(PathBuf::from(home).join(".local/share"));
+    }
+
+    if let Some(data_dirs) = std::env::var_os("XDG_DATA_DIRS") {
+        dirs.extend(std::env::split_paths(&data_dirs));
+    }
+
+    dirs
+}
+
+fn find_xdg_icon(icon: &str, directories: &[&str]) -> Option<PathBuf> {
+    for data_dir in xdg_data_dirs() {
+        for directory in directories {
+            let dir = data_dir.join(directory);
+
+            for extension in ICON_EXTENSIONS {
+                let path = dir.join(format!("{icon}{extension}"));
+
+                if path.is_file() {
+                    return Some(path);
+                }
+            }
+        }
+    }
+
+    None
 }
 
